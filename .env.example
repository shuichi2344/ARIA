# ─── ARIA Environment Configuration ──────────────────────────────────────────
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key
SUPABASE_DB_PASSWORD=your-database-password

# ─── Ilmu AI (Primary LLM) ───────────────────────────────────────────────────
# Get your API key from: https://console.ilmu.ai/dashboard/keys
ILMU_API_KEY=
ILMU_BASE_URL=https://api.ilmu.ai/v1
ILMU_MODEL=ilmu-nemo-nano

# ─── Ollama (Fallback LLM) ───────────────────────────────────────────────────
# Local inference — used when Ilmu AI is unavailable
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ─── Application ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
APP_URL=http://localhost:3000

# ─── News API (Optional) ─────────────────────────────────────────────────────
# Get your free API key from: https://newsdata.io/
NEWS_API_KEY=
NEWS_API_ENABLED=false
NEWS_CACHE_HOURS=6

# ─── SMTP (Optional — for password reset emails) ─────────────────────────────
# Leave empty to use dev mode (reset link printed to console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
