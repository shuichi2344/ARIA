# ─── ARIA Environment Configuration ──────────────────────────────────────────
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
# Service-role key (server-side only — never expose to frontend)
SUPABASE_KEY=your-supabase-service-role-key
# Anon/public key (safe for frontend, used by @supabase/supabase-js auth client)
SUPABASE_ANON_KEY=your-supabase-anon-key
# JWT secret — Supabase Dashboard > Project Settings > API > JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_DB_PASSWORD=your-database-password

# ─── Ilmu AI (Primary LLM) ───────────────────────────────────────────────────
# Get your API key from: https://console.ilmu.ai/dashboard/keys
ILMU_API_KEY=
ILMU_BASE_URL=https://api.ilmu.ai/v1
ILMU_MODEL=nemo-super

# ─── Ollama (Fallback LLM) ───────────────────────────────────────────────────
# Local inference — used when Ilmu AI is unavailable
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ─── Application ─────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
APP_URL=http://localhost:3000

# ─── News API (Optional) ─────────────────────────────────────────────────────
# Get your free API key from: https://newsdata.io/
NEWS_API_KEY=
NEWS_API_ENABLED=false
NEWS_CACHE_HOURS=6

